# Serveur
NODE_ENV=development
PORT=3000

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=senegal_connect
DB_USER=postgres
DB_PASS=change_me

# JWT
JWT_SECRET=change_me_generate_a_64_char_random_string
JWT_EXPIRES_IN=24h

# Logs
LOG_LEVEL=debug

# CORS (origines séparées par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:5500

# Upload
MAX_FILE_SIZE=10485760

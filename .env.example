# ============================================
# Sénégal Connect — Variables d'environnement
# ============================================

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=senegal_connect
DB_USER=postgres
DB_PASS=lahad

# --- JWT ---
JWT_SECRET=Changez-moi-en-production-avec-au-moins-64-caracteres-securises-merci-ok
JWT_EXPIRES_IN=24h

# --- Serveur ---
PORT=3000
NODE_ENV=development

# --- Logs ---
LOG_LEVEL=debug

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Uploads ---
MAX_FILE_SIZE=10485760

# --- PeerJS (port separe pour eviter le conflit WebSocket avec Socket.IO) ---
PEER_PORT=9000
